{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Bash(pwd)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch --show-current)",
      "Bash(git switch -c*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git init)",
      "Bash(./scripts/init.sh)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm verify)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm test*)",
      "Bash(pnpm eval)",
      "Bash(pnpm build)",
      "Bash(pnpm exec tsc*)",
      "Bash(pnpm exec vitest*)",
      "Bash(pnpm exec playwright test*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.test)",
      "Read(./**/*.pem)",
      "Read(./**/secrets/**)",
      "Read(./**/*_rsa)",
      "Read(./**/id_ed25519)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(pnpm add*)",
      "Bash(pnpm remove*)",
      "Bash(pnpm update*)",
      "Bash(pnpm dlx*)",
      "Bash(npx*)",
      "Bash(pnpm eval:live*)",
      "Bash(pnpm publish*)",
      "Bash(docker push*)",
      "Bash(vercel*)",
      "Bash(*deploy*)",
      "Bash(*migrate*)",
      "Bash(*db push*)",
      "Bash(*drizzle-kit push*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_secrets_patterns.py\""
          }
        ]
      }
    ]
  }
}
