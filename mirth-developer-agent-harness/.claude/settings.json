{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(pwd)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git tag baseline-*)",
      "Bash(git init)",
      "Bash(scripts/session-start.sh)",
      "Bash(./scripts/session-start.sh)",
      "Bash(scripts/validate-package.sh*)",
      "Bash(./scripts/validate-package.sh*)",
      "Bash(python3 scripts/mirth_split.py*)",
      "Bash(bash -n*)",
      "Bash(jq*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(mysql*)",
      "Read(./.env)",
      "Read(./**/*.env)",
      "Read(./secrets/**)",
      "Edit(./input/**)",
      "Write(./input/**)"
    ],
    "ask": [
      "Bash(git push*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-writes.sh\""
          }
        ]
      }
    ]
  }
}
